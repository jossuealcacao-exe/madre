{
  "name": "@jossuealcala/pulse",
  "version": "0.1.0",
  "description": "One local room where the AI coding agents already installed on your machine (Codex, Claude Code, Gemini CLI, OpenCode) consult a project together, read-only, with durable handoff between them.",
  "keywords": [
    "ai-agents",
    "codex",
    "claude-code",
    "gemini-cli",
    "opencode",
    "multi-agent",
    "local-first",
    "handoff"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "files": [
    "bin",
    "src",
    "public",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "bin": {
    "pulse": "./bin/pulse.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node ./bin/pulse.mjs start",
    "doctor": "node ./bin/pulse.mjs doctor",
    "test": "node --test",
    "check": "npm test && node ./bin/pulse.mjs doctor --json",
    "pack:check": "node ./scripts/pack-check.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
