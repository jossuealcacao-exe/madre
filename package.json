{
  "name": "@jossuealcala/madre",
  "version": "0.7.2",
  "description": "MADRE · one local room where the AI coding agents already on your machine (Codex, Claude Code, Gemini CLI, OpenCode) work on your project together, share one memory you can see and explore, and answer to you. Read-only by default, with per-message permission modes and checkpoints you can undo. Nothing leaves your machine on its own.",
  "keywords": [
    "ai-agents",
    "codex",
    "claude-code",
    "gemini-cli",
    "opencode",
    "multi-agent",
    "local-first",
    "handoff",
    "madre",
    "mother",
    "mu-th-ur",
    "memory",
    "sqlite",
    "mcp",
    "pulse"
  ],
  "homepage": "https://github.com/jossuealcacao-exe/madre#readme",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/jossuealcacao-exe"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jossuealcacao-exe/madre.git"
  },
  "bugs": {
    "url": "https://github.com/jossuealcacao-exe/madre/issues"
  },
  "author": {
    "name": "Jossué Alcalá",
    "url": "https://jossuealcala.com/en/"
  },
  "type": "module",
  "license": "Apache-2.0",
  "files": [
    "bin",
    "src",
    "public",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "docs/madre-banner.svg",
    "docs/room.png",
    "docs/training",
    "docs/SDK.md",
    "docs/sdk",
    "docs/INTERNALS.md",
    "docs/REFERENCE.md",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "bin": {
    "madre": "./bin/madre.mjs",
    "pulse": "./bin/madre.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node ./bin/madre.mjs start",
    "doctor": "node ./bin/madre.mjs doctor",
    "test": "node --import ./test/setup.mjs --test",
    "check": "npm test && node ./bin/madre.mjs doctor --json",
    "pack:check": "node ./scripts/pack-check.mjs",
    "release": "node ./scripts/release.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./sdk": "./src/modules/sdk.mjs",
    "./package.json": "./package.json"
  }
