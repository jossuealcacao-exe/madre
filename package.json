{
  "name": "@jossuealcala/madre",
  "version": "0.4.0",
  "description": "MADRE · one local room where the AI coding agents already on your machine (Codex, Claude Code, Gemini CLI, OpenCode) work on a project together, with a shared memory every one of them recalls and a local @madre that speaks for it. Read-only by default, per-message permission modes up to a checkpointed CONTROL. Nothing leaves your machine on its own.",
  "keywords": [
    "ai-agents",
    "codex",
    "claude-code",
    "gemini-cli",
    "opencode",
    "multi-agent",
    "local-first",
    "handoff",
    "madre",
    "mother",
    "mu-th-ur",
    "memory",
    "sqlite",
    "mcp",
    "pulse"
  ],
  "homepage": "https://github.com/jossuealcacao-exe/madre#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jossuealcacao-exe/madre.git"
  },
  "bugs": {
    "url": "https://github.com/jossuealcacao-exe/madre/issues"
  },
  "author": {
    "name": "Jossué Alcalá",
    "url": "https://jossuealcala.com/en/"
  },
  "type": "module",
  "license": "Apache-2.0",
  "files": [
    "bin",
    "src",
    "public",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "docs/madre-banner.svg",
    "docs/training",
    "docs/SDK.md",
    "docs/sdk",
    "docs/INTERNALS.md",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "bin": {
    "madre": "./bin/madre.mjs",
    "pulse": "./bin/madre.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node ./bin/madre.mjs start",
    "doctor": "node ./bin/madre.mjs doctor",
    "test": "node --import ./test/setup.mjs --test",
    "check": "npm test && node ./bin/madre.mjs doctor --json",
    "pack:check": "node ./scripts/pack-check.mjs",
    "release": "node ./scripts/release.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./sdk": "./src/modules/sdk.mjs",
    "./package.json": "./package.json"
  }
}
